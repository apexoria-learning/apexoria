# ---------------------------------------------------------------------------
# Apexoria Learning — root .gitignore
# Covers: Node/React CRA (frontend), env files, IDE, OS,
# build artifacts, test reports, and platform-internal folders.
# ---------------------------------------------------------------------------

# ---- Node / React (CRA + craco) ----
node_modules/
**/node_modules/
frontend/build/
frontend/.pnp
frontend/.pnp.js
frontend/coverage/
frontend/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---- Environment files (NEVER commit real secrets) ----
.env
.env.*
!.env.example
!.env.*.example

# ---- Test / CI outputs ----
test_reports/
*.log

# ---- Playwright (e2e/) ----
e2e/test-results/
e2e/playwright-report/
e2e/.playwright/

# ---- Editor / IDE ----
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Platform-internal (Emergent preview host) ----
.emergent/

# ---- Local overrides / scratch ----
*.local
.tmp/
tmp/
