// Firebase Storage security rules for the Apexoria CMS
// Only signed-in admins can upload / delete. Anyone can read (files are used publicly on the live site).
// Paste this into Firebase Console → Storage → Rules.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }
  }
}
