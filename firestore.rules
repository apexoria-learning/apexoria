// Firestore security rules for the Apexoria CMS
// Only pre-approved admin emails can read/write the /admins collection.
// Save this to `firestore.rules` and deploy via:
//   firebase deploy --only firestore:rules
// (or paste it into the Firebase Console → Firestore → Rules)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admins may look up their own record (used by the client-side allowlist check).
    // Only existing admins can add / remove other admins.
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow list: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
      allow create, update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
