# Local dev override. Same GF values as .env — Vercel picks these up from
# the Vercel dashboard's Environment Variables tab in production.
# No REACT_APP_BACKEND_URL needed since there is no backend.

# ====================================================================
# CMS — Firebase client config
# --------------------------------------------------------------------
# These REACT_APP_FIREBASE_* keys are baked into the JS bundle at
# build time and are safe to expose in-browser (they are public
# identifiers, not secrets — access is gated by Firestore rules +
# the /api/cms/commit serverless allowlist).
#
# Fill in the real values from the Firebase Console:
#   Project settings → General → Your apps → Web app → Config
#
# Leave the placeholder values in place if you don't need to test
# /admin locally — the marketing site works without them and the
# admin route will just show a Firebase-init error until filled in.
#
# In production, the REAL values live ONLY in the Vercel dashboard
# (Settings → Environment Variables), NEVER in this file or in git.
# ====================================================================
REACT_APP_FIREBASE_API_KEY="AIzaSyCmh5fwBjBm-1tG2Tyu5V7PRsRJEhxoopI"
REACT_APP_FIREBASE_AUTH_DOMAIN="apexorialearningcms.firebaseapp.com"
REACT_APP_FIREBASE_PROJECT_ID="apexorialearningcms"
REACT_APP_FIREBASE_STORAGE_BUCKET="apexorialearningcms.firebasestorage.app"
REACT_APP_FIREBASE_MESSAGING_SENDER_ID="659226371563"
REACT_APP_FIREBASE_APP_ID="1:659226371563:web:1a51eb8751c45c2d13a5ae"
REACT_APP_FIREBASE_MEASUREMENT_ID="G-E4KWDWYNB2"


# ====================================================================
# CMS — SERVER-SIDE ONLY (Vercel Serverless Function /api/cms/commit)
# --------------------------------------------------------------------
# These are NOT read locally (there is no local server). They live
# ONLY in the Vercel dashboard's Environment Variables tab, scoped
# to Production + Preview. Listed here for reference only — do NOT
# paste real values into this file.
#
#   GITHUB_TOKEN        Fine-grained PAT scoped to this repo only,
#                       with Contents: write. Never anywhere else.
#   GITHUB_OWNER        apexoria-learning
#   GITHUB_REPO         apexoria
#   GITHUB_BRANCH       main
#   FIREBASE_PROJECT_ID Same as REACT_APP_FIREBASE_PROJECT_ID above.
#   ADMIN_EMAILS        Comma-separated allowlist of Google emails
#                       (must match Firestore /admins/{email} docs).
# ====================================================================

